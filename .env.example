NODE_ENV=development
MOCK_MODE=true
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
NOTIFICATION_EMAIL=alerts@example.com
SENDER_EMAIL=sender@example.com
DYNAMODB_TABLE_NAME=job-scout-dev
USER_ID=default
PROFILE_PATH=config/profile.yaml
COMPANY_REGISTRY_PATH=config/companies.yaml
JOB_BOARDS_PATH=config/job-boards.yaml
# Optional marketplace credentials. Providers without configured credentials
# are skipped and reported unhealthy; they do not prevent application startup.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble remains disabled in config/job-boards.yaml until access and quota are approved.
JOOBLE_API_KEY=
SCORE_THRESHOLD=80
DIGEST_LIMIT=25
MAX_REQUESTS_PER_SCAN=200
MAX_JOBS_PER_SCAN=1000
MAX_BEDROCK_CALLS_PER_SCAN=50
MAX_RUNTIME_MS=240000
PRESENTATION_TIMEZONE=America/Toronto
DRY_RUN=true
BEDROCK_INPUT_COST_PER_MILLION=1
BEDROCK_OUTPUT_COST_PER_MILLION=5
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=3
HTTP_REQUESTS_PER_SECOND=5
HTTP_MAX_RESPONSE_BYTES=5000000
