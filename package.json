{
  "name": "job-scout",
  "version": "1.0.0",
  "description": "Serverless job discovery foundation",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/lambda/index.js --sourcemap --external:@aws-sdk/* --external:@nestjs/microservices --external:@nestjs/platform-express --external:@nestjs/websockets --external:class-validator --external:class-transformer && node scripts/prepare-lambda.mjs",
    "cli": "tsx src/cli.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "npm run build && npm run bundle && node scripts/package-lambda.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "jobs",
    "discovery",
    "lambda",
    "nestjs"
  ],
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-sesv2": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
